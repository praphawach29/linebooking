# =================================================================
# LINE OA Booking SaaS — Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values.
# NEVER commit .env with real credentials into version control.
# =================================================================

# Server Port and Node Environment
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Session / Transaction pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Server-side API Configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Allowed CORS Origins (comma-separated for production)
CORS_ORIGINS="http://localhost:3005,http://localhost:4000,https://booking.yourdomain.com"

# Background Job Queue (Redis / Upstash Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
# REDIS_URL="rediss://default:password@host:port"

# Optional: Omise Payment Secret Key (for recurring card billing)
# OMISE_SECRET_KEY="skey_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# BILLING_RETURN_URI="http://localhost:3005/merchant"

# Optional: JWT Secret (if using custom backend JWTs)
JWT_SECRET="your-256-bit-secret-key-here"
